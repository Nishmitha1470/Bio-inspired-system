import numpy as np
import matplotlib.pyplot as plt

np.random.seed(42)

n_particles = 30
n_iterations = 100
dimensions = 3

w = 0.7
c1 = 1.5
c2 = 1.5

lower = np.array([0.0, 0.0, 0.0])
upper = np.array([100.0, 100.0, 20.0])

dt = 0.01
time = np.arange(0, 5, dt)

def objective(x):

    Kp, Ki, Kd = x

    y = 0.0
    velocity = 0.0
    integral = 0.0
    previous_error = 1.0

    error_sum = 0.0

    for t in time:

        error = 1.0 - y
        integral += error * dt

        derivative = -velocity

        u = Kp * error + Ki * integral + Kd * derivative

        u = np.clip(u, -100, 100)

        acceleration = u - 10 * velocity - 20 * y

        velocity += acceleration * dt
        y += velocity * dt

        error_sum += t * abs(error) * dt

        if not np.isfinite(y):
            return 1e10

    return error_sum


position = np.random.uniform(
    lower, upper, (n_particles, dimensions)
)

velocity = np.zeros((n_particles, dimensions))

pbest = position.copy()

pbest_value = np.array([
    objective(p) for p in position
])

gbest_index = np.argmin(pbest_value)

gbest = pbest[gbest_index].copy()

gbest_value = pbest_value[gbest_index]

convergence = []

for iteration in range(n_iterations):

    for i in range(n_particles):

        r1 = np.random.rand(dimensions)
        r2 = np.random.rand(dimensions)

        velocity[i] = (
            w * velocity[i]
            + c1 * r1 * (pbest[i] - position[i])
            + c2 * r2 * (gbest - position[i])
        )

        position[i] += velocity[i]

        position[i] = np.clip(position[i], lower, upper)

        value = objective(position[i])

        if value < pbest_value[i]:

            pbest[i] = position[i].copy()
            pbest_value[i] = value

            if value < gbest_value:

                gbest = position[i].copy()
                gbest_value = value

    convergence.append(gbest_value)

print("Optimal PID Parameters:")

print("Kp =", round(gbest[0], 4))
print("Ki =", round(gbest[1], 4))
print("Kd =", round(gbest[2], 4))

print("Minimum Error =", round(gbest_value, 4))


Kp, Ki, Kd = gbest

y = 0.0
velocity = 0.0
integral = 0.0

response = []

for t in time:

    error = 1.0 - y
    integral += error * dt

    derivative = -velocity

    u = Kp * error + Ki * integral + Kd * derivative
    u = np.clip(u, -100, 100)

    acceleration = u - 10 * velocity - 20 * y

    velocity += acceleration * dt
    y += velocity * dt

    response.append(y)


plt.figure()
plt.plot(time, response)
plt.xlabel("Time (seconds)")
plt.ylabel("Output")
plt.title("PID Control System Response using PSO")
plt.grid()
plt.show()


plt.figure()
plt.plot(convergence)
plt.xlabel("Iterations")
plt.ylabel("Minimum Error")
plt.title("PSO Convergence Graph")
plt.grid()
plt.show()
